# ---- 临时产物（会话中间文件，可随时重建）----
.work/
.npm-cache/
__pycache__/
*.pyc

# ---- 文献原文 PDF（约 37 MB，可由 refs/tools/ 重新下载）----
# 下载记录见 refs/download-results.json 与 refs/参考文献原文获取清单-20261027.md
refs/pdfs/*.pdf

# ---- LaTeX 中间产物（latex/ 下，可随时重建；PDF 由 deliverables/ 归档）----
latex/**/*.aux
latex/**/*.bbl
latex/**/*.bcf
latex/**/*.blg
latex/**/*.fls
latex/**/*.fdb_latexmk
latex/**/*.log
latex/**/*.out
latex/**/*.toc
latex/**/*.xdv
latex/**/*.synctex.gz
latex/**/*.run.xml
latex/*.pdf

# ---- 系统/编辑器杂项 ----
Thumbs.db
desktop.ini
.DS_Store
*.tmp
~$*.docx
~$*.pdf
