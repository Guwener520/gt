# ---- 临时产物（会话中间文件，可随时重建）----
.work/
.npm-cache/
__pycache__/
*.pyc

# ---- 文献原文（PDF 与网页快照，只留本地）----
# 清单见 docs/参考文献清单-20261109.md
refs/pdfs/*.pdf
refs/pdfs/*.html

# ---- LaTeX 中间产物（latex/ 下，可随时重建；PDF 由 deliverables/ 归档）----
latex/**/*.aux
latex/**/*.bbl
latex/**/*.bcf
latex/**/*.blg
latex/**/*.fls
latex/**/*.fdb_latexmk
latex/**/*.log
latex/**/*.out
latex/**/*.toc
latex/**/*.xdv
latex/**/*.synctex.gz
latex/**/*.run.xml
latex/*.pdf

# ---- 系统/编辑器杂项 ----
Thumbs.db
desktop.ini
.DS_Store
*.tmp
~$*.docx
~$*.pdf
